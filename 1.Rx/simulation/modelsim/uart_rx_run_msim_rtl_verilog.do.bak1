transcript on
if {[file exists rtl_work]} {
	vdel -lib rtl_work -all
}
vlib rtl_work
vmap work rtl_work

vlog -vlog01compat -work work +incdir+D:/1.FPGA/1.Project_Quatus/12.UART_FPGA/1.Rx {D:/1.FPGA/1.Project_Quatus/12.UART_FPGA/1.Rx/Uart_Rx.v}

vlog -vlog01compat -work work +incdir+D:/1.FPGA/1.Project_Quatus/12.UART_FPGA/1.Rx {D:/1.FPGA/1.Project_Quatus/12.UART_FPGA/1.Rx/tb_Uart_Rx.v}

vsim -t 1ps -L altera_ver -L lpm_ver -L sgate_ver -L altera_mf_ver -L altera_lnsim_ver -L fiftyfivenm_ver -L rtl_work -L work -voptargs="+acc"  tb_Uart_Rx

add wave *
view structure
view signals
run -all
